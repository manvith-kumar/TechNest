# Copy to backend/.env and edit. backend/.env is git-ignored. These are placeholders, not real secrets.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=technest_db
DB_USERNAME=technest
DB_PASSWORD=change_me_dev_only
# Generate one with: openssl rand -base64 48   (the app refuses to start if it is short or still a placeholder)
JWT_SECRET=CHANGE_ME_replace_with_a_long_random_secret_of_at_least_32_chars
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
# DEV ONLY - writes password-reset links to the server log because no mail server is configured.
LOG_RESET_LINKS=true
